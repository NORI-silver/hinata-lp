{
 "name": "hinata",
 "site_label": "粗大ごみ手配ナビ（hinata.shiokonbu.com）",
 "base_url": "https://hinata.shiokonbu.com/",
 "repo_root": ".",
 "report_dir": "docs/article-review",
 "log": "docs/seo-log.md",
 "source": {"type": "local", "root": ".", "include": ["guide/*/index.html", "guide/item/*/index.html"]},
 "edit_where": "地域記事の本文は tools/guide/city/<key>.html、title・description・確認日は tools/guide/meta/<key>.json（最初の13地域は tools/guide/gencity.py）。直したら tools/guide/README.md の順にスクリプトを実行して guide/ を作り直す。guide/*/index.html を手で直さない",
 "rules": ["AGENTS.md", "docs/seo-playbook.md", "tools/guide/README.md"],
 "keywords": "docs/keywords.md",
 "priority_table": "docs/keywords.md",
 "expiry_list": "チームのメモ hinata-area-expiry（期限が来たら直す記述）",
 "critic_required_for": ["seo"],
 "body_tags": ["main", "article"],
 "entity": {"regex": "^(.+?[都道府県市区町村])の"},
 "official_hosts": ["lg.jp", "go.jp", "city", "town", "metro.tokyo.jp", "aeha-kadenrecycle.com", "aeha.or.jp"],
 "checked_regex": "(20\\d\\d)年(\\d{1,2})月(\\d{1,2})日に.{0,20}?確認",
 "stale_days": 150,
 "soon_days": 120,
 "old_source_years": 4,
 "title_range": [28, 35],
 "desc_range": [80, 120],
 "common_share": 0.3,
 "boilerplate_warn": 0.6,
 "must_text": ["目安"],
 "ng_text": ["通知します", "業界最安", "No.1", "件の実績", "必ず間に合"],
 "entity_link_check_types": ["area"],
 "cross_entity_ok": {"伊丹市": ["city.toyonaka.osaka.jp"]},
 "cross_entity_ok_note": "豊中市伊丹市クリーンランド（両市の一部事務組合）の持ち込みは豊中市のページに載っている（2026-10-31）",
 "shared_tel_ok": {"0570087200": "東京二十三区家電リサイクル受付センター（23区共通。2026-10-31 江東区・世田谷区の公式で確認）"},
 "types": [
  {"name": "area", "match": "^guide/(?!(fees|late|problem|scam|new-home|how-to-check|mochikomi|shoriken|size|item)/)[a-z]+/index\\.html$",
   "title_keywords": ["{entity}", "粗大ごみ"], "need_official_link": true, "min_h2": 5, "min_unique_chars": 600,
   "visual_when": ["一番長い辺", "3辺", "測", "貼って", "シールを", "処理券を"],
   "needs": [
    {"label": "申し込み方法（ネット・電話の窓口）", "any": ["申し込み", "申込"], "sev": "high"},
    {"label": "電話番号（ネットが苦手・急ぐ人向け）", "any": ["tel:", "\\d{2,4}-\\d{2,4}-\\d{3,4}"], "sev": "high", "hint": "受付センターか担当課の番号を載せる"},
    {"label": "料金（無料ならそう書く）", "any": ["円", "無料", "手数料はかかりません"], "sev": "high"},
    {"label": "収集までの日数・締め切り", "any": ["日前", "週間", "締め切", "締切", "最短", "日後", "か月", "前日"], "hint": "申し込みから何日かかるかが一番困るところ"},
    {"label": "出す日の時間・場所", "any": ["時まで", "時までに", "朝", "当日"], "hint": "何時までにどこへ出すか"},
    {"label": "持ち込み（急ぐとき）", "any": ["持ち込", "持込", "自己搬入"], "hint": "持ち込みが無い地域はそう書く"},
    {"label": "家電4品目", "any": ["家電4品目", "家電リサイクル"], "sev": "high"},
    {"label": "出せない物", "any": ["出せない", "収集しない", "受け付けない", "扱わない", "対象外"]},
    {"label": "間に合わないときの手", "any": ["間に合わない"]},
    {"label": "問い合わせ先", "any": ["問い合わせ", "問合せ", "担当", "窓口", "課（", "課 ", "センター（", "tel:"]}
   ]},
  {"name": "topic", "match": "^guide/(mochikomi|shoriken|size|item/[a-z]+)/index\\.html$", "min_h2": 3,
   "visual_when": ["一番長い辺", "3辺", "測", "貼"],
   "needs": [{"label": "地域ごとの違いへの案内（地域記事へのリンク）", "any": ["市", "区"]}]},
  {"name": "guide", "match": "^guide/(fees|late|problem|scam|new-home|how-to-check)/index\\.html$", "min_h2": 3}
 ]
}
